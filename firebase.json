{
  "apphosting": {
    "backendId": "megaanime-backend",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "scratch"
    ]
  },
  "firestore": {
    "databaseId": "(default)",
    "rules": "firestore.rules",
    "edition": "ENTERPRISE",
    "dataAccessMode": "FIRESTORE_NATIVE"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}